# Full Postgres connection string, e.g. postgresql+psycopg://user:password@host/dbname?sslmode=require
# Neon (serverless Postgres), dedicated project for this app - see neon.tech dashboard.
DATABASE_URL=

# Signs the Flask session cookie (login state). Required once APP_PASSWORD is
# set; any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Single shared password gating the whole app (dev-plan.md sec 13.3). Leave
# blank for local dev (no login prompt) - set it before deploying anywhere
# public (e.g. Vercel).
APP_PASSWORD=

# Vercel Blob read-write token - only needed when running on Vercel (local
# disk is used instead when this is blank). Vercel injects this automatically
# once a Blob store is connected to the project; for local testing against a
# real store, get it from the Vercel dashboard's Storage tab.
BLOB_READ_WRITE_TOKEN=

# Optional, for the later Telegram notification feature (Phase 4). Leave blank until needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
